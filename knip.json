{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "skills/dori-mode/scripts/src/cli.ts",
        "test/**/*.test.ts",
        "skills/dori-mode/scripts/test/**/*.test.ts",
        "skills/dori-mode/scripts/test/record-fetch.ts"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/**/*.ts",
        "test/**/*.ts",
        "skills/dori-mode/scripts/src/**/*.ts",
        "skills/dori-mode/scripts/test/**/*.ts"
      ]
    },
    "integrations/dots": {
      "entry": ["cli.ts", "*.test.ts"],
      "project": ["*.ts"]
    }
  },
  "ignoreExportsUsedInFile": true
}
